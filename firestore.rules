rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Inventory collection
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Dispatched records collection
    match /dispatchedRecords/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    // Audit logs collection
    match /auditLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
